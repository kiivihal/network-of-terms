# Search query for the merged "Brabantse personen & organisaties" dataset
# (planio #3544: one termenlijst for persons AND organisations).
#
# zpack-compatible port (target endpoint is kakugo zpack, not Fuseki),
# same deviations as crm-to-schema/*.rq:
#   - full-triple CONSTRUCT template (no `;` predicate-object lists —
#     kakugo docs/sparql-roadmap.md tracks this parser gap);
#   - no sub-SELECT (unsupported); the NoT #LIMIT# marker moves to the
#     outer query;
#   - type filter widened to schema:Person + schema:Organization (the
#     output types of crm-to-schema/person.rq and organization.rq);
#   - label properties matched via OPTIONALs instead of the
#     one-UNION-branch-per-property idiom (that idiom exists to keep
#     Fuseki from cross-multiplying multi-valued properties; the EMO
#     person/organisation records carry single-valued name fields, so
#     OPTIONAL is safe here — revisit if alternateName becomes
#     multi-valued).
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> skos:Concept .
    ?uri skos:prefLabel ?schema_name .
    ?uri skos:altLabel ?schema_alternateName .
    ?uri skos:scopeNote ?schema_description .
}
WHERE {
    ?uri a ?type .
    VALUES ?type { schema:Person schema:Organization }
    ?uri schema:name ?schema_name .
    FILTER(CONTAINS(LCASE(?schema_name), LCASE(?query)))
    OPTIONAL { ?uri schema:alternateName ?schema_alternateName }
    OPTIONAL { ?uri schema:description ?schema_description }
}
#LIMIT#
